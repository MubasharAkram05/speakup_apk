{
  "name": "speakup-english",
  "version": "1.0.0",
  "description": "SpeakUp English - professional English practice app (web + Android via Capacitor)",
  "private": true,
  "scripts": {
    "start": "npx http-server www -p 8080 -c-1",
    "check": "node scripts/check.js",
    "build:single": "node scripts/build-single.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  }
}
